# Copy to .env and fill in. Every variable the Go backend reads is listed here.
# docker compose reads this file for interpolation; `go run .` in backend/
# loads ./.env and ../.env if present (real environment variables win).

# ── Required ─────────────────────────────────────────────
# HMAC key for session tokens. >= 32 chars; the server refuses to start otherwise.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Postgres connection string. Leave unset under docker compose to use the
# bundled postgres service.
# POSTGRES_URL=postgres://kortex:kortex@localhost:5432/kortex?sslmode=disable

# Redis connection string (compose sets redis://redis:6379 itself).
REDIS_URL=redis://localhost:6379

# ── Public URL, CORS, cookies ───────────────────────────
# Origin short links are built on; also seeds the CORS allow-list and the
# COOKIE_SECURE default. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8090
# Comma-separated origins allowed to make credentialed requests.
# Default: PUBLIC_BASE_URL, http://localhost:3000, http://localhost:8090
CORS_ORIGINS=
# Mark auth cookies Secure. Default: true iff PUBLIC_BASE_URL starts with https://
COOKIE_SECURE=false
# Comma-separated CIDRs / IPs of reverse proxies whose X-Forwarded-For and
# X-Real-IP headers are trusted. Default: empty (trust none, use the socket peer).
TRUSTED_PROXIES=

# ── Demo / seed data ────────────────────────────────────
# Admin account created (or password-synced) on boot. Defaults are the public
# demo credentials; set your own for any non-demo deployment.
# ADMIN_EMAIL=admin@kortex.dev
# ADMIN_PASSWORD=kortex2026
# When true: the login page offers "Try the demo", which signs visitors into a
# shared non-admin account (DEMO_EMAIL) that owns the seeded links; that account
# has a random password and can't be used from the login form; and the seeded
# links can't be deleted or disabled. When false the seeded links belong to the admin.
DEMO_MODE=true
# DEMO_EMAIL=demo@kortex.dev
# Synthetic click events backfilled into analytics on boot (0 disables).
SEED_EVENTS=180000

# ── Analytics ───────────────────────────────────────────
# Days of click history kept in the in-memory columnar store.
ANALYTICS_RETENTION_DAYS=30
# Optional MaxMind GeoLite2-City .mmdb for country/city lookup. Cloudflare's
# CF-IPCountry header is used first when present; otherwise geo is "unknown".
GEOIP_DB=

# ── Topology / tuning ───────────────────────────────────
KORTEX_PORT=8090
# Display name reported by /api/system/stats.
NODE_NAME=kortex-01
# Snowflake node id (0-1023); must be unique per running instance.
NODE_ID=1
SHARD_COUNT=4
RING_VNODES=160
BUS_PARTITIONS=4
CACHE_TTL_SECONDS=3600
# Directory holding the built frontend; served with SPA fallback if it exists.
STATIC_DIR=/app/static
